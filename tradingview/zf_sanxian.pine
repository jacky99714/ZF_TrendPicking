//@version=6
indicator("ZF 三線開花", overlay=true, max_bars_back=500)

// ──────────────────────────────────────────────
// 參數設定
// ──────────────────────────────────────────────
ma8_len  = input.int(8,  "MA8 週期",  minval=3)
ma21_len = input.int(21, "MA21 週期", minval=10)
ma55_len = input.int(55, "MA55 週期", minval=20)
high_len = input.int(55, "收盤新高天數", minval=20)

// ──────────────────────────────────────────────
// 均線計算
// ──────────────────────────────────────────────
ma8  = ta.sma(close, ma8_len)
ma21 = ta.sma(close, ma21_len)
ma55 = ta.sma(close, ma55_len)

// ──────────────────────────────────────────────
// 條件 1：三線開花排列 close > MA8 > MA21 > MA55
// ──────────────────────────────────────────────
cond_alignment = close > ma8 and ma8 > ma21 and ma21 > ma55

// ──────────────────────────────────────────────
// 條件 2：創 55 日收盤價新高
// ──────────────────────────────────────────────
high_55d = ta.highest(close, high_len)
cond_new_high = close >= high_55d

// ──────────────────────────────────────────────
// 55 日次高價與差距比例
// ──────────────────────────────────────────────
// Pine Script 無法直接排序窗口取次高價，用迴圈實現
var float second_high = na
get_second_high(src, length) =>
    float highest_val = -1e10
    float second_val  = -1e10
    for i = 0 to length - 1
        val = src[i]
        if not na(val)
            if val > highest_val
                second_val  := highest_val
                highest_val := val
            else if val > second_val
                second_val  := val
    second_val > -1e10 ? second_val : na

second_high_55d = get_second_high(close, high_len)
gap_ratio = not na(second_high_55d) and second_high_55d > 0 ? (close / second_high_55d - 1) : na

// ──────────────────────────────────────────────
// 綜合判定
// ──────────────────────────────────────────────
is_sanxian = cond_alignment and cond_new_high

// ──────────────────────────────────────────────
// 繪圖：均線（漸層配色）
// ──────────────────────────────────────────────
plot(ma8,  "MA8",  color=color.new(#00E5FF, 0), linewidth=1)  // 青色
plot(ma21, "MA21", color=color.new(#2979FF, 0), linewidth=1)  // 藍色
plot(ma55, "MA55", color=color.new(#AA00FF, 0), linewidth=2)  // 紫色

// ──────────────────────────────────────────────
// 繪圖：55 日收盤高點線
// ──────────────────────────────────────────────
plot(high_55d, "55日高點", color=color.new(color.gray, 50),
     linewidth=1, style=plot.style_stepline)

// ──────────────────────────────────────────────
// 繪圖：信號標記
// ──────────────────────────────────────────────
plotshape(is_sanxian, title="三線開花信號",
     style=shape.circle, location=location.belowbar,
     color=color.new(#2979FF, 0), size=size.tiny)

// ──────────────────────────────────────────────
// 繪圖：背景色
// ──────────────────────────────────────────────
bgcolor(is_sanxian ? color.new(#2979FF, 92) : na, title="三線開花背景")

// ──────────────────────────────────────────────
// Data Window 驗證數值（點擊任意 K 棒，開右側 Data Window 查看）
// ──────────────────────────────────────────────
plot(is_sanxian ? 1 : 0,       "★ 三線開花=通過",   display=display.data_window)
plot(cond_alignment ? 1 : 0,   "① 三線排列",        display=display.data_window)
plot(cond_new_high ? 1 : 0,    "② 55日新高",        display=display.data_window)
plot(ma8,                       "  MA8",             display=display.data_window)
plot(ma21,                      "  MA21",            display=display.data_window)
plot(ma55,                      "  MA55",            display=display.data_window)
plot(high_55d,                  "  55日最高收盤",    display=display.data_window)
plot(second_high_55d,           "  55日次高價",      display=display.data_window)
plot(na(gap_ratio) ? 0 : gap_ratio * 100, "  差距比例%", display=display.data_window)

// ──────────────────────────────────────────────
// 資訊面板（最新 K 棒，含數值）
// ──────────────────────────────────────────────
f_pct(val) => not na(val) ? str.tostring(val * 100, "#.##") + "%" : "N/A"
f_price(val) => not na(val) ? str.tostring(val, "#.##") : "N/A"
f_check(cond) => cond ? "✓" : "✗"

var table info = table.new(position.bottom_right, 3, 6, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    table.cell(info, 0, 0, "三線開花條件", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, "", text_color=color.white, text_size=size.small)
    table.cell(info, 2, 0, is_sanxian ? "✓ 通過" : "✗ 未通過",
         text_color=is_sanxian ? color.lime : color.red, text_size=size.small)

    table.cell(info, 0, 1, "① 三線排列", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 1, f_price(close) + ">" + f_price(ma8) + ">" + f_price(ma21) + ">" + f_price(ma55),
         text_color=color.gray, text_size=size.tiny)
    table.cell(info, 2, 1, f_check(cond_alignment),
         text_color=cond_alignment ? color.lime : color.red, text_size=size.tiny)

    table.cell(info, 0, 2, "② 55日新高", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 2, "收盤:" + f_price(close) + " / 55日高:" + f_price(high_55d),
         text_color=color.gray, text_size=size.tiny)
    table.cell(info, 2, 2, f_check(cond_new_high),
         text_color=cond_new_high ? color.lime : color.red, text_size=size.tiny)

    table.cell(info, 0, 3, "差距比例", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 3, f_pct(gap_ratio),
         text_color=not na(gap_ratio) and gap_ratio > 0 ? color.lime : color.gray, text_size=size.tiny)
    table.cell(info, 2, 3, "", text_color=color.gray, text_size=size.tiny)

    table.cell(info, 0, 4, "次高價", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 4, f_price(second_high_55d), text_color=color.gray, text_size=size.tiny)
    table.cell(info, 2, 4, "", text_color=color.gray, text_size=size.tiny)

    table.cell(info, 0, 5, "55日最高", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 5, f_price(high_55d), text_color=color.gray, text_size=size.tiny)
    table.cell(info, 2, 5, "", text_color=color.gray, text_size=size.tiny)
