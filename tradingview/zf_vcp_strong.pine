//@version=6
indicator("ZF VCP 強勢", overlay=true, max_bars_back=500)

// ──────────────────────────────────────────────
// 參數設定
// ──────────────────────────────────────────────
ma50_len  = input.int(50,  "MA50 週期",  minval=10)
ma150_len = input.int(150, "MA150 週期", minval=50)
ma200_len = input.int(200, "MA200 週期", minval=100)
slope_lookback = input.int(20, "MA200 斜率回看天數", minval=5)
return_lookback = input.int(20, "報酬率回看天數", minval=5)
// 大盤指數：預設自動判斷（台股=TAIEX，美股=SPX），可手動覆蓋
is_tw = str.startswith(syminfo.prefix, "TWSE") or str.startswith(syminfo.prefix, "TPEX")
auto_market = is_tw ? "TWSE:TAIEX" : "SP:SPX"
use_custom_market = input.bool(false, "手動指定大盤指數", display=display.none)
custom_market = input.symbol("SP:SPX", "自訂大盤指數", display=display.none)
effective_market = use_custom_market ? custom_market : auto_market

// ──────────────────────────────────────────────
// 均線計算
// ──────────────────────────────────────────────
ma50  = ta.sma(close, ma50_len)
ma150 = ta.sma(close, ma150_len)
ma200 = ta.sma(close, ma200_len)

// ──────────────────────────────────────────────
// 條件 1：均線多頭排列 close > MA50 > MA150 > MA200
// ──────────────────────────────────────────────
cond_alignment = close > ma50 and ma50 > ma150 and ma150 > ma200

// ──────────────────────────────────────────────
// 條件 2：MA200 趨勢向上（今日 MA200 > 20日前 MA200）
// ──────────────────────────────────────────────
ma200_prev = ma200[slope_lookback]
cond_ma200_up = not na(ma200_prev) and ma200 > ma200_prev

// ──────────────────────────────────────────────
// 條件 3：20日報酬率 > 大盤20日報酬率
// ──────────────────────────────────────────────
stock_return = close / close[return_lookback] - 1
market_close = request.security(effective_market, timeframe.period, close)
market_return = market_close / market_close[return_lookback] - 1
cond_beat_market = not na(stock_return) and not na(market_return) and stock_return > market_return

// ──────────────────────────────────────────────
// 綜合判定
// ──────────────────────────────────────────────
is_vcp_strong = cond_alignment and cond_ma200_up and cond_beat_market

// ──────────────────────────────────────────────
// 繪圖：均線
// ──────────────────────────────────────────────
plot(ma50,  "MA50",  color=color.new(color.orange, 0), linewidth=1)
plot(ma150, "MA150", color=color.new(color.blue, 0),   linewidth=1)
plot(ma200, "MA200", color=color.new(color.red, 0),    linewidth=2)

// ──────────────────────────────────────────────
// 繪圖：信號標記
// ──────────────────────────────────────────────
plotshape(is_vcp_strong, title="VCP 強勢信號",
     style=shape.triangleup, location=location.belowbar,
     color=color.new(color.green, 0), size=size.small)

// ──────────────────────────────────────────────
// 繪圖：背景色
// ──────────────────────────────────────────────
bgcolor(is_vcp_strong ? color.new(color.green, 90) : na, title="強勢背景")

// ──────────────────────────────────────────────
// Data Window 驗證數值（點擊任意 K 棒，開右側 Data Window 查看）
// display.data_window 只顯示在資料視窗，不繪製在圖表上
// ──────────────────────────────────────────────
plot(is_vcp_strong ? 1 : 0,   "★ VCP強勢=通過",    display=display.data_window)
plot(cond_alignment ? 1 : 0,  "① 多頭排列",         display=display.data_window)
plot(cond_ma200_up ? 1 : 0,   "② MA200向上",        display=display.data_window)
plot(cond_beat_market ? 1 : 0,"③ 打敗大盤",         display=display.data_window)
plot(ma50,                     "  MA50",             display=display.data_window)
plot(ma150,                    "  MA150",            display=display.data_window)
plot(ma200,                    "  MA200",            display=display.data_window)
plot(ma200_prev,               "  MA200(20日前)",    display=display.data_window)
plot(stock_return * 100,       "  個股報酬%",        display=display.data_window)
plot(market_return * 100,      "  大盤報酬%",        display=display.data_window)

// ──────────────────────────────────────────────
// 資訊面板（最新 K 棒，含數值）
// ──────────────────────────────────────────────
f_pct(val) => str.tostring(val * 100, "#.##") + "%"
f_price(val) => str.tostring(val, "#.##")
f_check(cond) => cond ? "✓" : "✗"

market_label = use_custom_market ? custom_market : (is_tw ? "台股 TAIEX" : "美股 S&P500")
var table info = table.new(position.top_right, 3, 6, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    table.cell(info, 0, 0, "VCP 強勢 (" + market_label + ")", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, "", text_color=color.white, text_size=size.small)
    table.cell(info, 2, 0, is_vcp_strong ? "✓ 通過" : "✗ 未通過",
         text_color=is_vcp_strong ? color.lime : color.red, text_size=size.small)

    table.cell(info, 0, 1, "① 多頭排列", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 1, f_price(close) + ">" + f_price(ma50) + ">" + f_price(ma150) + ">" + f_price(ma200),
         text_color=color.gray, text_size=size.tiny)
    table.cell(info, 2, 1, f_check(cond_alignment),
         text_color=cond_alignment ? color.lime : color.red, text_size=size.tiny)

    table.cell(info, 0, 2, "② MA200向上", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 2, f_price(ma200) + " vs " + f_price(ma200_prev),
         text_color=color.gray, text_size=size.tiny)
    table.cell(info, 2, 2, f_check(cond_ma200_up),
         text_color=cond_ma200_up ? color.lime : color.red, text_size=size.tiny)

    table.cell(info, 0, 3, "③ 打敗大盤", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 3, f_pct(stock_return) + " vs " + f_pct(market_return),
         text_color=color.gray, text_size=size.tiny)
    table.cell(info, 2, 3, f_check(cond_beat_market),
         text_color=cond_beat_market ? color.lime : color.red, text_size=size.tiny)

    table.cell(info, 0, 4, "個股報酬", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 4, f_pct(stock_return), text_color=stock_return > 0 ? color.lime : color.red, text_size=size.tiny)
    table.cell(info, 2, 4, "", text_color=color.gray, text_size=size.tiny)
