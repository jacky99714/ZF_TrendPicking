//@version=6
indicator("ZF VCP 新高", overlay=true, max_bars_back=500)

// ──────────────────────────────────────────────
// 參數設定
// ──────────────────────────────────────────────
high5_len    = input.int(5,   "近期高點天數",   minval=1)
high52w_len  = input.int(252, "52週高點天數",   minval=100)
tolerance    = input.float(0.10, "新高容差", minval=0.01, maxval=0.50, step=0.01)
return_lookback = input.int(20, "報酬率回看天數", minval=5)
// 大盤指數：預設自動判斷（台股=TAIEX，美股=SPX），可手動覆蓋
is_tw = str.startswith(syminfo.prefix, "TWSE") or str.startswith(syminfo.prefix, "TPEX")
auto_market = is_tw ? "TWSE:TAIEX" : "SP:SPX"
use_custom_market = input.bool(false, "手動指定大盤指數", display=display.none)
custom_market = input.symbol("SP:SPX", "自訂大盤指數", display=display.none)
effective_market = use_custom_market ? custom_market : auto_market

// ──────────────────────────────────────────────
// 高低點計算
// ──────────────────────────────────────────────
high_5d  = ta.highest(high, high5_len)
high_252d = ta.highest(high, high52w_len)

// ──────────────────────────────────────────────
// 條件 1：接近 52 週新高（容差內）
// |high_5d / high_252d - 1| <= tolerance
// ──────────────────────────────────────────────
gap_pct = math.abs(high_5d / high_252d - 1)
cond_near_high = not na(high_252d) and gap_pct <= tolerance

// ──────────────────────────────────────────────
// 條件 2：20日報酬率 > 大盤20日報酬率
// ──────────────────────────────────────────────
stock_return = close / close[return_lookback] - 1
market_close = request.security(effective_market, timeframe.period, close)
market_return = market_close / market_close[return_lookback] - 1
cond_beat_market = not na(stock_return) and not na(market_return) and stock_return > market_return

// ──────────────────────────────────────────────
// 綜合判定
// ──────────────────────────────────────────────
is_vcp_newhigh = cond_near_high and cond_beat_market

// ──────────────────────────────────────────────
// 繪圖：52 週高點線
// ──────────────────────────────────────────────
plot(high_252d, "52週高點", color=color.new(color.orange, 30),
     linewidth=2, style=plot.style_stepline)

// ──────────────────────────────────────────────
// 繪圖：容差區間
// ──────────────────────────────────────────────
upper_band = high_252d * (1 + tolerance)
lower_band = high_252d * (1 - tolerance)
p_upper = plot(upper_band, "容差上限", color=color.new(color.yellow, 70), linewidth=1, style=plot.style_stepline)
p_lower = plot(lower_band, "容差下限", color=color.new(color.yellow, 70), linewidth=1, style=plot.style_stepline)
fill(p_upper, p_lower, color=color.new(color.yellow, 92), title="新高容差區間")

// ──────────────────────────────────────────────
// 繪圖：信號標記
// ──────────────────────────────────────────────
plotshape(is_vcp_newhigh, title="VCP 新高信號",
     style=shape.diamond, location=location.abovebar,
     color=color.new(color.yellow, 0), size=size.small)

// ──────────────────────────────────────────────
// 繪圖：背景色
// ──────────────────────────────────────────────
bgcolor(is_vcp_newhigh ? color.new(color.yellow, 92) : na, title="新高背景")

// ──────────────────────────────────────────────
// Data Window 驗證數值（點擊任意 K 棒，開右側 Data Window 查看）
// ──────────────────────────────────────────────
plot(is_vcp_newhigh ? 1 : 0,  "★ VCP新高=通過",    display=display.data_window)
plot(cond_near_high ? 1 : 0,  "① 接近52週高",      display=display.data_window)
plot(cond_beat_market ? 1 : 0,"② 打敗大盤",        display=display.data_window)
plot(high_5d,                  "  5日最高",          display=display.data_window)
plot(high_252d,                "  52週最高",         display=display.data_window)
plot(gap_pct * 100,            "  差距%",            display=display.data_window)
plot(tolerance * 100,          "  容差%",            display=display.data_window)
plot(stock_return * 100,       "  個股報酬%",        display=display.data_window)
plot(market_return * 100,      "  大盤報酬%",        display=display.data_window)

// ──────────────────────────────────────────────
// 資訊面板（最新 K 棒，含數值）
// ──────────────────────────────────────────────
f_pct(val) => str.tostring(val * 100, "#.##") + "%"
f_price(val) => str.tostring(val, "#.##")
f_check(cond) => cond ? "✓" : "✗"

market_label = use_custom_market ? custom_market : (is_tw ? "台股 TAIEX" : "美股 S&P500")
var table info = table.new(position.middle_right, 3, 5, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    table.cell(info, 0, 0, "VCP 新高 (" + market_label + ")", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, "", text_color=color.white, text_size=size.small)
    table.cell(info, 2, 0, is_vcp_newhigh ? "✓ 通過" : "✗ 未通過",
         text_color=is_vcp_newhigh ? color.lime : color.red, text_size=size.small)

    table.cell(info, 0, 1, "① 接近52週高", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 1, "5日高:" + f_price(high_5d) + " / 52週高:" + f_price(high_252d),
         text_color=color.gray, text_size=size.tiny)
    table.cell(info, 2, 1, f_check(cond_near_high),
         text_color=cond_near_high ? color.lime : color.red, text_size=size.tiny)

    table.cell(info, 0, 2, "   差距/容差", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 2, f_pct(gap_pct) + " / " + f_pct(tolerance),
         text_color=gap_pct <= tolerance ? color.lime : color.red, text_size=size.tiny)
    table.cell(info, 2, 2, "", text_color=color.gray, text_size=size.tiny)

    table.cell(info, 0, 3, "② 打敗大盤", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 3, f_pct(stock_return) + " vs " + f_pct(market_return),
         text_color=color.gray, text_size=size.tiny)
    table.cell(info, 2, 3, f_check(cond_beat_market),
         text_color=cond_beat_market ? color.lime : color.red, text_size=size.tiny)

    table.cell(info, 0, 4, "個股報酬", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 4, f_pct(stock_return), text_color=stock_return > 0 ? color.lime : color.red, text_size=size.tiny)
    table.cell(info, 2, 4, "", text_color=color.gray, text_size=size.tiny)
